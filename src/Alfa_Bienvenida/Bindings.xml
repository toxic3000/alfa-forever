<Bindings>
	<!-- 1.3.8: el modo Zen (Zen.lua): todo Alfa fuera menos la flecha; otra pulsación lo devuelve. -->
	<Binding name="ALFA_ZEN" category="Alfa" searchTags="BINDING_TAG_ALFA">
		if AlfaZen and AlfaZen.Alternar then AlfaZen.Alternar() end
	</Binding>
	<!-- 1.3.9 (36): «Cerrar mis misiones» con una tecla (AlfaRuta.CerrarTodo: el mismo plan de todos lados). -->
	<Binding name="ALFA_CERRAR_MISIONES" category="Alfa" searchTags="BINDING_TAG_ALFA">
		if AlfaBienvenida and AlfaBienvenida.CerrarMisiones then AlfaBienvenida.CerrarMisiones() end
	</Binding>
</Bindings>
